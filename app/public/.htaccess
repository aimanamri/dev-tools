# ── MIME types ────────────────────────────────────────────────────────────────
# Apache does not serve .mjs as application/javascript by default.
# Without this, browsers refuse to execute .mjs files as ES modules
# (including the PDF.js worker bundled by Vite as pdf.worker-*.mjs).
AddType application/javascript .mjs

Options -MultiViews
RewriteEngine On

# ── Force HTTPS ───────────────────────────────────────────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── SPA routing — send non-file/non-directory requests to index.html ──────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]

# ── Security headers ──────────────────────────────────────────────────────────
# Keep these values the same as nginx.conf and the preview headers in vite.config.js.
<IfModule mod_headers.c>
  # Prevent MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Clickjacking protection (frame-ancestors in the CSP does the same)
  Header always set X-Frame-Options "DENY"

  # Do not send the page address to other sites
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Deny browser APIs that this site does not use
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=(), payment=(), interest-cohort=()"

  # Use HTTPS only, for one year
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Isolate the page from windows that other sites open
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # Content Security Policy
  # All scripts, fonts and styles come from this origin. No eval. No external hosts.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' data: blob:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
</IfModule>
